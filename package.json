{
    "name": "karako-iam-theme",
    "version": "1.0.0",
    "description": "Starter for Keycloakify themes using React, Shadcn, TailwindCSS and Keycloakify",
    "type": "module",
    "private": true,
    "scripts": {
        "postinstall": "node scripts/vite-bin-shim.mjs && keycloakify sync-extensions",
        "dev": "vp dev",
        "build": "tsc && vp build",
        "start": "bun run build && keycloakify start-keycloak --keycloak-version 26",
        "build-storybook": "storybook build",
        "build-keycloak-theme": "bun run build && keycloakify build",
        "storybook": "storybook dev -p 6006",
        "test": "vp test run --project storybook",
        "sync:brand": "bun run scripts/sync-brand.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "emails:check": "KARAKO_EMAIL_PREVIEW=1 email check ./src/email/templates --use-preview-props",
        "emails:preview": "KARAKO_EMAIL_PREVIEW=1 email preview ./src/email/templates --use-preview-props"
    },
    "keywords": [],
    "packageManager": "bun",
    "overrides": {
        "hono": "^4.12.25",
        "postcss": "^8.5.26",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
        "vitest": "4.1.11"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@keycloakify/login-ui": "~250004.7.2",
        "@tailwindcss/vite": "^4.3.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "i18next": "^26.4.0",
        "input-otp": "^1.5.0",
        "keycloakify": "^11.15.14",
        "lucide-react": "^1.34.0",
        "radix-ui": "^1.6.7",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-i18next": "^17.0.12",
        "react-icons": "^5.7.0",
        "rfc4648": "^1.5.4",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tsafe": "^1.8.5",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@storybook/addon-a11y": "^10.5.10",
        "@storybook/addon-docs": "^10.5.10",
        "@storybook/addon-vitest": "^10.5.10",
        "@storybook/react-vite": "^10.5.10",
        "@types/node": "^26.3.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@typescript-eslint/eslint-plugin": "^8.68.0",
        "@typescript-eslint/parser": "^8.68.0",
        "@vitejs/plugin-react": "^6.1.0",
        "@vitest/browser-playwright": "4.1.11",
        "@vitest/coverage-v8": "4.1.11",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.4",
        "eslint-plugin-storybook": "^10.5.10",
        "globals": "^17.11.0",
        "jsx-email": "^3.2.1",
        "keycloakify-emails": "3.4.0",
        "playwright": "latest",
        "prettier": "3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "remark-gfm": "^4.0.1",
        "storybook": "^10.5.10",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.68.0",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
        "vite-plus": "0.3.0",
        "vitest": "4.1.11"
    },
    "engines": {
        "bun": "^1.3.0"
    }
}
