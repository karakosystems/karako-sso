# Reference of environment variables consumed by Keycloak in a production
# deployment of the Karako IAM image. Copy to .env and fill in real values.
# (Not consumed by the local-dev compose.yml - see CLAUDE.md.)

# Admin bootstrap user - created on first start only
KC_BOOTSTRAP_ADMIN_USERNAME=change_me_admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change_me_strong_password

# Database
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change_me_db_password

# Hostname / reverse proxy
KC_HOSTNAME=auth.example.com
KC_HOSTNAME_STRICT=true
KC_PROXY_HEADERS=xforwarded
KC_HTTP_ENABLED=true

# Health endpoints (/health, /health/ready, /health/live)
KC_HEALTH_ENABLED=true

# Logging
KC_LOG=console
KC_LOG_CONSOLE_OUTPUT=json
KC_LOG_LEVEL=INFO

# Branding - all optional, read at container start. See README.md for the
# accepted values of BASE, LAYOUT and DECOR.
KARAKO_BRAND_NAME=Example
KARAKO_BRAND_LEGAL_NAME=Example Corporation
KARAKO_BRAND_WELCOME_MESSAGE=Sign in to your Example workspace.
KARAKO_BRAND_LOGO_URL=https://cdn.example.com/logo.png
KARAKO_BRAND_LOGO_DARK_URL=https://cdn.example.com/logo-white.png
KARAKO_BRAND_FAVICON_URL=https://cdn.example.com/favicon.ico
KARAKO_BRAND_PRIMARY=#0055aa
KARAKO_BRAND_BASE=gray
KARAKO_BRAND_RADIUS=0.625rem
KARAKO_BRAND_LAYOUT=centered
KARAKO_BRAND_DECOR=shape
